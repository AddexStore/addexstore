# ============================================================
# AddexStores Frontend - Environment Configuration Example
# Copy this file to .env and fill in your values.
# ============================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Backend API Origin (for asset URL construction)
VITE_API_ORIGIN=http://localhost:8080

# Frontend Deployment URL
VITE_FRONTEND_URL=http://localhost:5173

# Stripe Publishable Key (from Stripe Dashboard)
VITE_STRIPE_PUBLISHABLE_KEY=

# Razorpay Key ID (from Razorpay Dashboard)
VITE_RAZORPAY_KEY_ID=

# Application Name
VITE_APP_NAME=AddexStores

# Environment Label
VITE_ENVIRONMENT=development
