# ==========================================
# AddexStores Frontend - Environment Variables
# ==========================================

# API Configuration
VITE_API_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:8080

# Asset CDN (falls back to API_ORIGIN if not set)
VITE_ASSET_ORIGIN=

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=

# Razorpay
VITE_RAZORPAY_KEY_ID=

# App
VITE_APP_NAME=AddexStores
VITE_ENVIRONMENT=development
