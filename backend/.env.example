# ===========================================
# AddexStores Backend - Environment Variables
# ===========================================

# --- Database (PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/addexstores_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Redis ---
# Option 1: Individual fields (local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Option 2: Upstash / Railway Redis URL (production)
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=

# --- JWT ---
# REQUIRED: Generate a secure random string (min 32 chars hex-encoded)
# Example: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Server ---
# Railway sets PORT automatically; only override for local dev
SERVER_PORT=8080
PORT=8080

# --- File Upload ---
UPLOAD_DIR=./uploads

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AWS S3 (optional, falls back to local storage if not set) ---
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# --- Cache (redis or simple) ---
CACHE_TYPE=redis

# --- Logging ---
LOG_LEVEL=INFO

# --- CORS ---
# REQUIRED in production: Set to your Vercel deployment URL
# Example: https://your-project.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Swagger ---
SWAGGER_SERVER_URL=http://localhost:8080

# --- Email (optional) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- Active Profile ---
# Use 'dev' for local development, 'production' for deployed environments
# In production: Swagger/Actuator restricted to ADMIN, logging reduced
ACTIVE_PROFILE=dev
